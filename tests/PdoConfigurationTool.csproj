<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RuntimeConfigurations.props" Condition="'$(RuntimeConfigurationsImported)' != 'true'" />
  <PropertyGroup>
    <TargetFrameworks>net481;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildNet8)' == 'true'">net8.0;net481</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PdoConfigurationTool</AssemblyName>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <OutputPath>build\tool\$(Platform)\$(BaseBuildConfiguration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" />
    <Compile Include="PdoConfigurationTool.cs" />
  </ItemGroup>
  <PropertyGroup>
    <IntermediateOutputPath>obj\$(SolutionName)\$(Platform)\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <OutputPath Condition="'$(TargetFramework)' == 'net8.0'">$(OutputPath.TrimEnd('\'))\net8.0\</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <Prefer32Bit Condition="'$(TargetFramework)' == 'net481' and '$(Platform)' == 'AnyCPU'">true</Prefer32Bit>
  </PropertyGroup>
</Project>
