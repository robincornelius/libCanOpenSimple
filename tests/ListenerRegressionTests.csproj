<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ListenerRegressionTests</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <OutputPath>build\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>build\obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">TRACE;DEBUG</DefineConstants>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- Test the production sources directly without adding test-only public APIs. -->
    <Compile Include="..\*.cs" />
    <Compile Include="ListenerRegressionTests.cs" />
    <Compile Include="SdoRegressionTests.cs" />
    <Compile Include="PdoConfigurationTests.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
